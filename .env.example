# Copy to .env.local and fill in. Never commit real keys.

# Contact form (EmailJS)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# AI assist (optional). Read at build time: rebuild after changing it.
NEXT_PUBLIC_AI_ENABLED=false
# Server only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried when the primary model's quota is used up (each model has its own free quota).
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Limits. Gemini free-tier quotas are per Google Cloud project and reset at midnight Pacific.
AI_DAILY_BUDGET=450
AI_USER_DAILY_LIMIT=10
AI_USER_MINUTE_LIMIT=5
# Set to true after enabling billing: lifts the EEA/UK/Switzerland restriction of the free tier.
AI_PAID_TIER=false

# Recommended in production so limits are shared by all serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
